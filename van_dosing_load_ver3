def vanco_load(weight):
    load = 25
    result = weight * load
    if result > 3000:
        return 3000
    else:
        return result

#calculate vanco maintenance dose using fctn and dose rounding#
def vanco_ongoing(weight):
    ongoing = 15 
    result_ongoing = weight * ongoing
    if result_ongoing > 1500:
        return 1500
    else: 
        return result_ongoing
    
