#calculate vanco load using fctn add dose rounding - Version 3 - add max dose of 3000 mg #

def vanco_load(weight):
    load = 25
    result = weight * load
    if result > 3000:
        return 3000
    else:
        return result

#calculate vanco maintenance dose using fctn and dose rounding#
def vanco_ongoing(weight):
    ongoing = 15 
    result_ongoing = weight * ongoing
    if result_ongoing > 1500:
        return 1500
    else: 
        return result_ongoing
    
patient_age = float(input("What is the patient's age? "))  
patient_creatinine = float(input("What is the patient's creatinine in umol/L? "))
weight = float(input("What is the patient's weight? "))

def creatinine_clearance(patient_age,weight,patient_creatinine):
    clearance = ((((140-patient_age) * weight)/patient_creatinine) *1.23)
    return clearance
crcl = creatinine_clearance(patient_age, weight,patient_creatinine)
def vanco_freq(patient_age,patient_creatinine):
    if patient_age >= 20 and patient_age <=29 and patient_creatinine >=40 and patient_creatinine <=80:
        return ("q8h")
    elif patient_age >=20 and patient_age<= 29 and patient_creatinine >=81 and patient_creatinine <=140:
        return ("q12h")
    elif patient_age >=20 and patient_age <=29 and patient_creatinine >=141 and patient_creatinine <=160:
        return ("q18h")
    elif patient_age >=20 and patient_age <=29 and patient_creatinine >=161 and patient_creatinine <=200:
        return ("q24h")
    else:
        return ("consult pharmacy")


result = vanco_load(weight)
result_ongoing = vanco_ongoing(weight)
vanco_dose_freq = vanco_freq(patient_age,patient_creatinine)



round_result = round(result/250) *250
round_ongoing = round(result_ongoing/250) * 250
print(f"The patients vancomycin loading dose is", round_result ,"mg")
